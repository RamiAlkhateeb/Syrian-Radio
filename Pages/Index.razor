@page "/"

<PageTitle>محطات الراديو السورية - البث المباشر</PageTitle>

<main class="station-directory" lang="ar" dir="rtl">
    <header class="directory-header">
        <p class="eyebrow">بث مباشر من سوريا</p>
        <h1>اختر محطتك</h1>
        <p>استمع إلى بث محطات الراديو السورية مباشرةً.</p>
    </header>

    <section class="station-grid" aria-label="Radio stations">
        <a class="station-card station-card-sham" href="http://radio.sham.fm/" dir="rtl">
            <span class="station-card-logo"><img src="img/sham-fm-logo.png" alt="شعار شام FM" /></span>
            <span class="station-card-content">
                <span class="station-card-name">شام FM</span>
                <span class="station-card-description">استمع إلى البث المباشر</span>
                <span class="station-card-action">فتح البث <span aria-hidden="true">←</span></span>
            </span>
        </a>

        <a class="station-card station-card-damascus" href="https://damasradio.fm/" dir="rtl">
            <span class="station-card-logo"><img src="img/radio-damascus-logo.svg" alt="شعار إذاعة دمشق" /></span>
            <span class="station-card-content">
                <span class="station-card-name">إذاعة دمشق</span>
                <span class="station-card-description">البث المباشر من دمشق</span>
                <span class="station-card-action">استمع الآن <span aria-hidden="true">←</span></span>
            </span>
        </a>

        <a class="station-card station-card-ninar" href="/ninar-fm" dir="ltr">
            <span class="station-card-logo"><img src="img/ninar-logo.png" alt="شعار نينار FM" /></span>
            <span class="station-card-content">
                <span class="station-card-name">Ninar FM</span>
                <span class="station-card-description" lang="ar" dir="rtl">البث المباشر من سوريا</span>
                <span class="station-card-action" lang="ar" dir="rtl">استمع الآن <span aria-hidden="true">←</span></span>
            </span>
        </a>
    </section>
</main>
