@page "/"
@implements IAsyncDisposable
@inject IJSRuntime JS

<PageTitle>محطات الراديو السورية - البث المباشر</PageTitle>

<main class="radio-app" lang="ar" dir="rtl">
    <div class="radio-device">
        <!-- Top: brand + on-air status -->
        <header class="radio-topbar">
            <span class="radio-brand-word">راديو سوريا</span>
            <span class="radio-onair"><span class="radio-onair-dot"></span>ON AIR</span>
        </header>

        <!-- Display: station frequency + logo -->
        <div class="radio-display">
            <div class="radio-dial">@Stations[Current].Dial</div>
            <div class="radio-now">
                <img class="radio-now-logo" src="@Stations[Current].Logo" alt="شعار @Stations[Current].Name" />
                <div class="radio-now-meta">
                    <strong class="radio-now-name">@Stations[Current].Name</strong>
                    <span class="radio-now-desc">@Stations[Current].Description</span>
                </div>
            </div>
        </div>

        <!-- Tuning roller: slide to change the channel -->
        <div class="radio-tuner">
            <div class="radio-tuner-labels">
                @foreach (var s in Stations)
                {
                    <span class="@(s == Stations[Current] ? "on" : "")">@s.ShortLabel</span>
                }
            </div>
            <input class="radio-roller"
                   type="range"
                   min="0" max="@(Stations.Count - 1)" step="1"
                   value="@Current"
                   aria-label="ضبط المحطة"
                   @oninput="OnTune" />
        </div>

        <!-- Action -->
        <a class="radio-listen" href="@Stations[Current].Href" dir="rtl">
            <span>@Stations[Current].ActionText</span>
            <span class="radio-listen-arrow" aria-hidden="true">◀</span>
        </a>

        <a class="radio-about-link" href="/about">عن التطبيق</a>
    </div>
</main>

@if (showIosOnboarding)
{
    <div class="ios-onboarding-backdrop" role="presentation">
        <section class="ios-onboarding" role="dialog" aria-modal="true" aria-labelledby="ios-onboarding-title">
            <span class="ios-onboarding-icon" aria-hidden="true">↥</span>
            <h2 id="ios-onboarding-title">أضف راديو سوريا إلى الشاشة الرئيسية</h2>
            <p>للوصول السريع إلى التطبيق من هاتفك:</p>
            <ol>
                <li>اضغط زر المشاركة في Safari.</li>
                <li>اختر <strong>«إضافة إلى الشاشة الرئيسية»</strong>.</li>
            </ol>
            <button class="ios-onboarding-dismiss" @onclick="DismissIosOnboarding">فهمت</button>
        </section>
    </div>
}

@code {
    private sealed record Station(
        string Name,
        string ShortLabel,
        string Dial,
        string Description,
        string ActionText,
        string Logo,
        string Href);

    // NOTE: FM frequencies below are approximate/illustrative dial labels.
    private List<Station> Stations { get; } =
    [
        new Station("نينار FM", "نينار", "89.6 FM", "البث المباشر من سوريا", "استمع الآن", "img/ninar-logo.png", "/ninar-fm"),
        new Station("شام FM", "شام", "92.3 FM", "أغانٍ وأخبار من دمشق", "فتح البث", "img/sham-fm-logo.png", "http://radio.sham.fm/"),
        new Station("إذاعة دمشق", "دمشق", "95.0 FM", "البث الرسمي من دمشق", "استمع الآن", "img/radio-damascus-logo.svg", "https://damasradio.fm/"),
        new Station("راديو سوريا", "سوريا", "WEB", "البث المباشر لقناة سوريا", "فتح البث", "img/syria-tv.png", "https://www.syria.tv/%D8%B1%D8%A7%D8%AF%D9%8A%D9%88-%D8%B3%D9%88%D8%B1%D9%8A%D8%A7")
    ];

    private int Current { get; set; }

    private void OnTune(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var index))
        {
            Current = Math.Clamp(index, 0, Stations.Count - 1);
        }
    }

    private IJSObjectReference? onboardingModule;
    private bool showIosOnboarding;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        onboardingModule = await JS.InvokeAsync<IJSObjectReference>("import", "./js/iosOnboarding.js");
        showIosOnboarding = await onboardingModule.InvokeAsync<bool>("claimFirstVisit");

        if (showIosOnboarding)
        {
            StateHasChanged();
        }
    }

    private void DismissIosOnboarding() => showIosOnboarding = false;

    public async ValueTask DisposeAsync()
    {
        if (onboardingModule is not null)
        {
            try
            {
                await onboardingModule.DisposeAsync();
            }
            catch (JSDisconnectedException) { }
        }
    }
}
