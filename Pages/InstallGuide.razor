@page "/install"

<PageTitle>طريقة تثبيت التطبيق - راديو سوريا</PageTitle>

<main class="install-page" lang="ar" dir="rtl">
    <div class="install-header">
        <a class="back-link" href="/">← كل المحطات</a>
        <h1 class="install-title">إضافة التطبيق إلى الشاشة الرئيسية</h1>
        <p class="install-subtitle">استمع إلى محطاتك المفضلة بنقرة واحدة من شاشة هاتفك الرئيسية بدون الحاجة لفتح المتصفح في كل مرة.</p>
    </div>

    <div class="install-card">
        <div class="ios-carousel">
            <p class="ios-carousel-progress">الخطوة <strong>@(Current + 1)</strong> من @Slides.Count</p>

            <div class="ios-carousel-track" style="transform: translateX(@(Current * -100)%);">
                @foreach (var slide in Slides)
                {
                    <div class="ios-carousel-slide">
                        <div class="ios-carousel-copy">
                            <span class="ios-step-badge">@slide.Badge</span>
                            <h2>@slide.Action</h2>
                            <p>@slide.Description</p>
                        </div>
                        <div class="ios-carousel-image-frame">
                            <img class="ios-carousel-img" src="@slide.Image" alt="@slide.Alt" loading="eager" />
                        </div>
                    </div>
                }
            </div>

            <div class="ios-carousel-dots" role="tablist" aria-label="خطوات التثبيت">
                @for (var i = 0; i < Slides.Count; i++)
                {
                    <button type="button"
                            class="ios-carousel-dot @(i == Current ? "active" : "")"
                            aria-label="الخطوة @(i + 1)"
                            aria-selected="@(i == Current)"
                            role="tab"
                            @onclick="() => GoTo(i)"></button>
                }
            </div>

            <div class="ios-carousel-actions">
                @if (Current > 0)
                {
                    <button type="button" class="ios-nav-back" @onclick="GoBack">← السابق</button>
                }
                else
                {
                    <span class="ios-nav-spacer"></span>
                }

                @if (Current < Slides.Count - 1)
                {
                    <button type="button" class="ios-nav-next" @onclick="GoNext">التالي ←</button>
                }
                else
                {
                    <a class="ios-nav-done" href="/">البدء الآن 🎧</a>
                }
            </div>
        </div>
    </div>
</main>

@code {
    private sealed record Slide(string Badge, string Action, string Description, string Image, string Alt);

    private List<Slide> Slides { get; } =
    [
        new(
            "الخطوة 1",
            "افتح الموقع وافتح قائمة المتصفح",
            "على آيفون اضغط زر المشاركة (⎘)، وعلى أندرويد اضغط أيقونة النقاط الثلاث (⋮) في زاوية الشاشة.",
            "img/step%201.jpg",
            "فتح قائمة المتصفح لبدء التثبيت"),
        new(
            "الخطوة 2",
            "اختر «إضافة إلى الشاشة الرئيسية»",
            "من القائمة اختر خيار «إضافة إلى الشاشة الرئيسية» أو «تثبيت التطبيق» (Add to Home screen).",
            "img/step%202.jpg",
            "اختيار إضافة التطبيق إلى الشاشة الرئيسية"),
        new(
            "الخطوة 3",
            "اضغط «إضافة» لتأكيد التثبيت",
            "اضغط على زر «إضافة» أو «تثبيت»، وسيظهر رمز التطبيق مباشرة على شاشة هاتفك الرئيسية.",
            "img/step%203.jpg",
            "تأكيد إضافة التطبيق إلى الشاشة الرئيسية")
    ];

    private int Current { get; set; }

    private void GoBack() => GoTo(Current - 1);
    private void GoNext() => GoTo(Current + 1);
    private void GoTo(int index) => Current = Math.Clamp(index, 0, Slides.Count - 1);
}
