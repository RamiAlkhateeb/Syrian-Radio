@implements IAsyncDisposable
@inject IJSRuntime JS

<div class="player-card">
    <div class="station-logo">
        <img src="@LogoUrl" alt="شعار @StationName" />
    </div>

    <h1 class="station-name">@StationName</h1>
    <p class="station-tagline">@Tagline</p>

    <div class="status-row">
        <span class="status-dot status-@statusClass"></span>
        <span class="status-text">@statusText</span>
    </div>

    <audio id="@audioElementId" preload="none"></audio>

    <div class="controls-row">
        <button class="play-btn" @onclick="TogglePlay" aria-label="@(isPlaying ? "إيقاف مؤقت" : "تشغيل")">
            @if (isPlaying)
            {
                <span>&#10074;&#10074;</span>
            }
            else
            {
                <span>&#9654;</span>
            }
        </button>

        <div class="volume-row">
            <span>&#128266;</span>
            <input type="range" min="0" max="100" value="@volume"
                   @oninput="OnVolumeChanged" />
        </div>
    </div>
</div>

@code {
    [Parameter] public string StationName { get; set; } = "Ninar FM";
    [Parameter] public string Tagline { get; set; } = "البث المباشر من سوريا";
    [Parameter, EditorRequired] public string LogoUrl { get; set; } = "";
    [Parameter, EditorRequired] public string StreamUrl { get; set; } = "";
    [Parameter] public bool UseNinarProxy { get; set; }

    private readonly string audioElementId = "ninar-audio-" + Guid.NewGuid().ToString("N");
    private IJSObjectReference? module;
    private DotNetObjectReference<RadioPlayer>? dotNetRef;

    private bool isPlaying;
    private int volume = 80;
    private string statusClass = "idle";
    private string statusText = "جاهز للتشغيل";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/radioPlayer.js");
            dotNetRef = DotNetObjectReference.Create(this);
            await module.InvokeVoidAsync("init", audioElementId, dotNetRef);
            await module.InvokeVoidAsync("setVolume", volume / 100.0);
        }
    }

    private async Task TogglePlay()
    {
        if (module is null) return;

        if (isPlaying)
        {
            await module.InvokeVoidAsync("pause");
            isPlaying = false;
            SetStatus("paused", "متوقف مؤقتاً");
        }
        else
        {
            SetStatus("buffering", "جارٍ الاتصال...");
            isPlaying = true;
            await module.InvokeVoidAsync("play", StreamUrl, UseNinarProxy);
        }
    }

    private async Task OnVolumeChanged(ChangeEventArgs e)
    {
        if (module is null) return;
        if (int.TryParse(e.Value?.ToString(), out var v))
        {
            volume = v;
            await module.InvokeVoidAsync("setVolume", volume / 100.0);
        }
    }

    [JSInvokable]
    public void OnStatusChanged(string status)
    {
        switch (status)
        {
            case "live":
                isPlaying = true;
                SetStatus("live", "على الهواء الآن");
                break;
            case "buffering":
                SetStatus("buffering", "جارٍ تحميل البث...");
                break;
            case "paused":
                isPlaying = false;
                SetStatus("paused", "متوقف مؤقتاً");
                break;
            case "error":
                isPlaying = false;
                SetStatus("error", "انقطع الاتصال - اضغط تشغيل للمحاولة مجدداً");
                break;
        }
        StateHasChanged();
    }

    private void SetStatus(string cls, string text)
    {
        statusClass = cls;
        statusText = text;
    }

    public async ValueTask DisposeAsync()
    {
        if (module is not null)
        {
            try
            {
                await module.InvokeVoidAsync("dispose");
                await module.DisposeAsync();
            }
            catch (JSDisconnectedException) { }
        }
        dotNetRef?.Dispose();
    }
}
